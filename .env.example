# Copy this file to .env.local and fill in the values for your environment.
# Every variable must be prefixed with VITE_ to be exposed to the browser —
# never put a secret here, anything in this file ships in the bundle.

# Base URL that every axios request is resolved against.
VITE_API_BASE_URL=https://api.example.com

# Path (or absolute URL) the contact form posts to.
VITE_CONTACT_ENDPOINT=/contact

# Google reCAPTCHA v2 site key. Leave empty to disable the widget locally —
# the matching secret key lives on the server that verifies the token.
VITE_RECAPTCHA_SITE_KEY=

# ImageKit delivery endpoint for portfolio media.
VITE_IMAGEKIT_BASE_URL=https://ik.imagekit.io/gavin/gavinpereira

# Canonical origin, used for canonical links and Open Graph URLs.
VITE_SITE_URL=https://gavn.in

# Forces a seasonal theme instead of detecting it from the date.
# One of: xmas | halloween | diwali | default. Leave empty to auto-detect.
VITE_SEASON_OVERRIDE=
